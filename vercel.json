{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/newsletters",
      "destination": "/news#newsletter",
      "permanent": true
    },
    {
      "source": "/life",
      "destination": "/facilities",
      "permanent": true
    },
    {
      "source": "/life/:path*",
      "destination": "/facilities",
      "permanent": true
    }
  ]
}