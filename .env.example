[TEMPLATE]
# Ask EIS chat uses the Groq API. Set the key in one of these places:
#   - Vercel (https://vercel.com) -> Project Settings -> Environment Variables, or
#   - cPanel -> File Manager -> public_html -> create a file named `.env` containing:
#       GROQ_API_KEY=your_key_here
#   The .htaccess shipped with the cPanel build blocks direct access to `.env`.
GROQ_API_KEY=